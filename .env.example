# wiwi environment variables — copy to .env and fill in your values.
# .env is loaded automatically by wiwi and docker-compose (env_file).

# Master key for admin API and UI access (required for admin features).
WIWI_MASTER_KEY=sk-wiwi-master-change-me

# Database URL. Supports postgresql://, postgres://, and sqlite+aiosqlite:///.
# If unset, defaults to SQLite at /app/data/wiwi.db (Docker) or wiwi.db (local).
# Examples:
#   Local Postgres:    postgresql://wiwi:wiwi@localhost:5432/wiwi
#   Neon:              postgresql://user:pass@host/db?sslmode=require
#   Supabase:          postgresql://user:pass@host:5432/postgres
#   SQLite (local):    sqlite+aiosqlite:///wiwi.db
# Unset → SQLite (wiwi.yaml `general_settings.database_url`, or wiwi.db locally).
# Setting this to the placeholder below is what a `cp .env.example .env` used to
# do, and it overrides that default with an unreachable host. Leave it commented
# until you have a real server (docker compose supplies one when it is unset).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/wiwi

# Reverse-proxy peers whose X-Forwarded-* headers wiwi may trust (login/signup
# throttle keying, the session cookie's Secure flag, OAuth callback scheme).
# Comma- or whitespace-separated CIDRs. Set this when TLS terminates in front of
# wiwi — an ingress, CDN, or PaaS router — or the cookie is not marked Secure.
#   WIWI_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1/32
# Empty/unset trusts no forwarded header (fail-closed).
WIWI_TRUSTED_PROXIES=

# Stream journal directory (restart-safe SSE reconnect replay). Overrides
# wiwi.yaml `router_settings.stream_journal_dir`; empty/unset falls back to the
# configured value. Point this at PERSISTENT storage (a mounted volume) so replay
# survives a restart — and in a container at a WRITABLE one: the configured
# default is relative and resolves against the process CWD, which is read-only
# for the non-root `wiwi` user in the shipped image. The image sets
# /data/journals itself; override only if your platform mounts elsewhere.
# An unwritable directory is reported at startup as
# `stream_journal_dir_unwritable` and costs reconnect-resume, not availability.
# WIWI_STREAM_JOURNAL_DIR=/data/journals

# Provider API keys (at least one is needed to serve requests).
# Providers whose keys are unset are silently filtered out at config load.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GMI_API_KEY=

# HuggingFace write token — used by deploy/hf_space.sh to push this gateway to
# the Space `shimen/yapapa` (https://huggingface.co/spaces/shimen/yapapa).
# Needs repo.write on the Space's owner. Not read by the gateway itself.
HF_TOKEN=
