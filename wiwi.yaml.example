# wiwi sample configuration
providers:
  - name: openai-main
    provider: openai
    keys:
      - {label: main, key: os.environ/OPENAI_API_KEY, weight: 3}
      - {label: backup, key: os.environ/OPENAI_API_KEY_2, weight: 1}

  - name: anthropic-main
    provider: anthropic
    keys:
      - {label: main, key: os.environ/ANTHROPIC_API_KEY}

  - name: local-ollama
    provider: openai-compatible
    base_url: http://localhost:11434/v1
    keys:
      - {label: local, key: "ollama"}

  - name: openrouter
    provider: openrouter
    base_url: https://openrouter.ai/api/v1
    extra_headers:
      X-Title: wiwi-gateway
    keys:
      - {label: main, key: os.environ/OPENROUTER_API_KEY}

  - name: gmicloud
    provider: gmicloud
    base_url: https://api.gmi-serving.com/v1
    keys:
      - {label: main, key: os.environ/GMI_API_KEY}

model_list:
  - model_name: gpt-4o
    wiwi_params: {provider: openai-main, model: gpt-4o, weight: 2}
  - model_name: gpt-4o-mini
    wiwi_params: {provider: openai-main, model: gpt-4o-mini}
  - model_name: claude-sonnet
    wiwi_params: {provider: anthropic-main, model: claude-sonnet-4-20250514, max_tokens: 8192}
  - model_name: llama-local
    wiwi_params: {provider: local-ollama, model: llama3.1}
  # OpenRouter model pinned to a specific underlying provider (GMICloud).
  # The extra_body.provider.only field is sent as-is to OpenRouter, which
  # routes the request only to the named provider slug.
  - model_name: minimax/minimax-m3
    wiwi_params:
      provider: openrouter
      model: minimax/minimax-m3
      extra_body:
        provider:
          only: ["gmicloud"]
  # GMI Cloud direct provider — OpenAI-compatible inference API.
  - model_name: deepseek-v3.2
    wiwi_params:
      provider: gmicloud
      model: deepseek-ai/DeepSeek-V3.2
  - model_name: glm-5
    wiwi_params:
      provider: gmicloud
      model: zai-org/GLM-5-FP8

router_settings:
  routing_strategy: simple-shuffle
  num_retries: 2
  timeout: 120
  allowed_fails: 3
  cooldown_time: 30
  # global_rpm: 600        # optional gateway-wide RPM/TPM caps (per process)
  # global_tpm: 200000
  fallbacks:
    claude-sonnet: ["gpt-4o"]
  model_group_alias:
    gpt-4: gpt-4o

general_settings:
  master_key: os.environ/WIWI_MASTER_KEY
  # Database: SQLite (default) or PostgreSQL.  The DATABASE_URL env var
  # overrides this setting if set.  For serverless Postgres (Neon, Supabase),
  # set DATABASE_URL in .env or your container env instead of using this key.
  # database_url: sqlite+aiosqlite:///wiwi.db          # SQLite (default)
  # database_url: postgresql+asyncpg://user:pass@host:5432/db?sslmode=require  # Postgres
  database_url: os.environ/DATABASE_URL

wiwi_settings:
  drop_params: true
  port: 4000
  # store_prompts_in_spend_logs: true   # log full request/response content (off by default)
