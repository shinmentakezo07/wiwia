# wiwi sample configuration
providers:
  - name: openai-main
    provider: openai
    keys:
      - {label: main, key: os.environ/OPENAI_API_KEY, weight: 3}
      - {label: backup, key: os.environ/OPENAI_API_KEY_2, weight: 1}

  - name: anthropic-main
    provider: anthropic
    keys:
      - {label: main, key: os.environ/ANTHROPIC_API_KEY}

  - name: local-ollama
    provider: openai-compatible
    base_url: http://localhost:11434/v1
    keys:
      - {label: local, key: "ollama"}

  - name: openrouter
    provider: openrouter
    base_url: https://openrouter.ai/api/v1
    extra_headers:
      X-Title: wiwi-gateway
    keys:
      - {label: main, key: os.environ/OPENROUTER_API_KEY}

  - name: gmicloud
    provider: gmicloud
    base_url: https://api.gmi-serving.com/v1
    keys:
      - {label: main, key: os.environ/GMI_API_KEY}

  - name: bai
    provider: bai
    base_url: https://api.b.ai/v1
    keys:
      - {label: main, key: os.environ/BAI_API_KEY}

  - name: nvidia-nim
    provider: nvidia-nim
    base_url: https://integrate.api.nvidia.com/v1
    keys:
      - {label: main, key: os.environ/NVIDIA_NIM_API_KEY}

  - name: opencode-zen
    provider: opencode
    base_url: https://opencode.ai/zen/v1
    # A paid-model deployment carries a real Zen key. A free-tier `*-free`
    # deployment instead uses the literal sentinel `anonymous` (omit
    # Authorization entirely): the live catalog lists nine free models (eight
    # `-free` suffixed plus the stealth `big-pickle`), and on 2026-09-19 all
    # nine passed the admission gate keyless — seven answered 200, two failed
    # upstream on their own account (500 / `server_error`). A real account key
    # instead 429s FreeUsageLimitError once that account's free quota is spent,
    # so a key is not what unlocks them. The 403 FreeTierError that used to be
    # blamed on "a missing key" is a request-shape gate (forced SSE, a
    # CLI-shaped `x-opencode-session`, and the CLI's `bash`/`read` decoy tools)
    # that the adapter now satisfies on every free-model request. See
    # opencode_adapter.py and AUDIT #267.
    keys:
      - {label: main, key: os.environ/OPENCODE_API_KEY}
      # free-tier-only setup:
      # - {label: anon, key: anonymous}

# Model groups: map a model_name clients request to one or more provider
# deployments. Empty by default — add your own via the admin UI (/models) or
# here. Each entry needs a model_name and wiwi_params with a provider (one of
# the names under `providers:` above) and the native model id.
#
# Example shape:
#   - model_name: my-gpt
#     wiwi_params: {provider: openai-main, model: gpt-4o, weight: 2}
#
# Per-deployment caps (opt-in): a deployment at its cap is skipped in favour
# of a sibling, and when every candidate is capped the request gets a 429
# (with Retry-After) instead of running uncapped. Both are 60-second sliding
# windows, the same interval as a virtual key's rpm/tpm.
#   rpm: 500        # requests per minute through this deployment
#   tpm: 100000     # tokens (estimated at admission, reconciled to actual)
#                   # per minute through this deployment
#
# Anthropic prompt caching (opt-in, per deployment):
#   prompt_cache: true   # mark the STABLE prefix (tools + system) so repeat
#                        # calls read at 0.1x instead of paying full input.
#                        # The trailing user turn is never marked — it varies
#                        # per request, and a breakpoint on changing content
#                        # writes a new entry every call and never reads one.
#   prompt_cache_min_tokens: 1024   # skip when the prefix is shorter than
#                        # this; Anthropic silently doesn't cache below a
#                        # model-specific minimum (512-4096 tokens).
model_list: []

router_settings:
  routing_strategy: simple-shuffle
  num_retries: 2
  timeout: 120             # default per-request timeout; a provider's own
                           # timeout_s overrides it, and a deployment's
                           # wiwi_params.timeout overrides both
  allowed_fails: 3
  cooldown_time: 30
  # global_rpm: 600        # optional gateway-wide RPM/TPM caps (per process)
  # global_tpm: 200000
  # Concurrency ceiling per deployment. Uncomment to shed load with 503 +
  # Retry-After instead of queueing into a saturated upstream. A deployment's
  # own wiwi_params.max_inflight overrides this.
  # max_inflight: 8
  # inflight_retry_after_s: 1.0
  # Lanes partition a deployment's concurrency by share: bulk is refused at 2
  # while interactive may still reach 8. Shares must each be in (0, 1] and sum
  # to <= 1.0. A key with no lane (or an unknown lane) lands on default_lane.
  # priority_lanes:
  #   interactive: 0.8
  #   bulk: 0.2
  # default_lane: bulk
  # Pin a client session (x-wiwi-session-id) to the deployment that served it, so
  # upstream prompt caches stay warm. A pin is dropped as soon as its deployment
  # is unhealthy or above this request's lane ceiling.
  # session_affinity: false
  # session_affinity_ttl_s: 600
  fallbacks:
    claude-sonnet: ["gpt-4o"]
  model_group_alias:
    gpt-4: gpt-4o
  # Durable stream journal: SSE chunks are journaled to disk per request so a
  # client can reconnect with `x-wiwi-stream-id` + `Last-Event-ID` after a
  # restart and replay what it missed.
  stream_journal_enabled: true
  # stream_journal_dir: .wiwi/journals
  # stream_journal_ttl_s: 600
  # stream_journal_max_bytes: 1048576

# Exact-match response cache (docs/CORE.md §6): non-streaming requests keyed on
# normalized IR + group + surface + key. Off by default; bypass one call with
# the `x-wiwi-no-cache: true` header.
cache_settings:
  enabled: false
  # ttl_s: 3600
  # max_entries: 256   # memory backend only; Redis is bounded by Redis itself
  # Exact-match cache: only non-streaming, deterministic requests are stored.
  # A request with temperature > 0 (or n > 1) is never cached — an identical
  # prompt legitimately yields different text when sampling, and caching it
  # would pin callers to whichever completion came back first.

# OTLP trace export (docs/CONFIG.md § Telemetry). Off by default, and free when
# off: with `enabled: false` the gateway never imports the SDK. Requires the
# `otel` extra (`uv pip install -e '.[otel]'`) — without it, enabling this logs a
# warning and stays a no-op rather than failing. One span per request, with a
# child span per upstream attempt, plus `traceparent` in both directions and an
# `x-wiwi-trace-id` response header.
# telemetry:
#   enabled: false
#   endpoint: http://localhost:4318/v1/traces   # OTLP/HTTP
#   service_name: wiwi
#   sample_ratio: 1.0                           # roots only; callers' choice is kept
#   export_timeout_s: 10.0                      # bounds one export to a dead collector
#   headers:                                    # extra headers for the collector
#     authorization: Bearer <token>

general_settings:
  master_key: os.environ/WIWI_MASTER_KEY
  # Database: SQLite (default) or PostgreSQL.  The DATABASE_URL env var
  # overrides this setting if set.  For serverless Postgres (Neon, Supabase),
  # set DATABASE_URL in .env or your container env instead of using this key.
  # database_url: sqlite+aiosqlite:///wiwi.db          # SQLite (default)
  # database_url: postgresql+asyncpg://user:pass@host:5432/db?sslmode=require  # Postgres
  database_url: os.environ/DATABASE_URL
  # Optional Redis. Requires the [redis] extra (uv pip install -e '.[redis]').
  # When set, the exact-match response cache (see cache_settings) is stored in
  # Redis: entries survive a restart and are shared across replicas.
  # Unset (default) keeps the in-memory LRU, which is faster for one process.
  # redis_url: redis://localhost:6379/0
  # Reverse-proxy peers whose X-Forwarded-* headers wiwi may trust. Set this
  # when TLS terminates in front of wiwi (a load balancer, ingress, or CDN):
  # it gates (a) X-Forwarded-For keying of the login/signup abuse throttles,
  # (b) the session cookie's Secure flag, and (c) the scheme of Cline OAuth
  # callback URLs. Empty means those headers are never trusted. The env var
  # takes a comma- or whitespace-separated list, e.g.
  # WIWI_TRUSTED_PROXIES="127.0.0.1/32,10.0.0.0/8" — the usual way to set it
  # in a container, where there is no config file to edit.
  trusted_proxies: os.environ/WIWI_TRUSTED_PROXIES
  # What a virtual key's max_budget means when a model has no pricing row.
  # Unpriced models cost $0 in the cost engine, so with the default ("warn")
  # a budget-capped key can serve an unpriced model forever without the cap
  # ever tripping — each such request is tagged `unpriced_model` in the
  # request log instead. "reject" fails closed: budget-capped keys get 503
  # until an admin adds the price. "admit" restores fully silent behaviour.
  # unpriced_model_policy: warn

wiwi_settings:
  drop_params: true
  port: 4000
  # store_prompts_in_spend_logs: true   # log full request/response content (off by default)
  # Responses API state: a completed /v1/responses call is stored so the client
  # can continue it with previous_response_id (and read it back with
  # GET /v1/responses/{id}). Scoped to the owning virtual key. ttl_s <= 0 keeps
  # rows forever; expiry is enforced on read and by a background sweeper.
  store_responses: true
  response_store_ttl_s: 86400
  # Retention and storage cap for request_logs. Both roll the rows they remove
  # into request_rollups first, so the dashboard's totals, token counts, cost
  # and percentiles stay complete — only per-request detail is dropped.
  # Percentiles survive as a compact per-bucket histogram, so they merge
  # correctly when a window spans both fresh and rolled-up rows.
  log_retention_days: 30                 # drop raw rows older than this (0 = keep forever)
  log_max_rows: 10000                    # keep at most N raw rows (0 = unlimited)
  log_prune_interval_s: 3600             # seconds between sweeps (0 = startup only)
