# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Project-local tooling
.omo/
.codegraph/

# Live config & secrets (tracked template: wiwi.yaml.example)
wiwi.yaml
key.md
# Same class as key.md: a plaintext scratch file of live OAuth
# access/refresh tokens. It is not named after any convention this file
# already covers, so `git add -A` would otherwise commit live credentials
# (AUDIT #164).
code.md
wiwi.db
# SQLite WAL sidecars: untracked, and `git clean -fd` would otherwise unlink
# the live DB's WAL while a backend holds it open, silently dropping writes.
wiwi.db-shm
wiwi.db-wal

# Local opencode agent config (holds live provider keys, e.g. ptcider-alt)
opencode.json
opencode.jsonc

# Admin-UI exports (downloaded to the repo root by the browser). Both carry
# live credentials in plaintext — provider keys/OAuth tokens — so they must
# never be committed. The `*` also covers the browser's duplicate-name suffix
# (`wiwi-providers-2026-09-16 (1).json`).
wiwi-providers-*.json
workbuddy-auths-*.json

# Local scratch project (not part of wiwi)
tryproxy/

# omp CLI local secrets (provider keys)
.env

# Local verification scratch (holds live keys/db)
.verify/

# Runtime stream journals (restart-safe SSE replay scratch)
.wiwi/

# Agent tooling scratch
.impeccable/

# Build artifacts
web/node_modules/
web/tsconfig.tsbuildinfo
# Admin SPA built bundles (regenerated by `cd web && bun run build`)
wiwi/server/static/assets/*.js
wiwi/server/static/assets/*.css
wiwi/server/static/index.html
# Rust implementation (wiwi2) build artifacts
wiwi2/target/

# Go implementation (wiwi3) build artifacts
wiwi3/bin/

# Agent harness scratch
.omp/

# HAR captures
*.har
